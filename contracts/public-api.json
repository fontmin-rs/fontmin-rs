{
  "schemaVersion": 1,
  "stability": "release-candidate",
  "cli": {
    "commands": {
      "bench": {
        "flags": [
          "--basic-text",
          "--json",
          "--text",
          "--text-file",
          "--unicodes"
        ],
        "shortFlags": ["-b", "-t"],
        "positionals": ["INPUT"]
      },
      "build": {
        "flags": [
          "--basic-text",
          "--cache",
          "--config",
          "--css-glyph",
          "--css-unicode-range",
          "--deflate-woff",
          "--delivery-slice",
          "--drop-tables",
          "--font-family",
          "--font-path",
          "--formats",
          "--gids",
          "--glyph-names",
          "--layout-features",
          "--layout-languages",
          "--layout-scripts",
          "--missing-glyphs",
          "--name-ids",
          "--name-languages",
          "--no-cache",
          "--no-original",
          "--out-dir",
          "--pass-through-tables",
          "--preset",
          "--retain-gids",
          "--retain-glyph-names",
          "--retain-legacy-cmap",
          "--retain-symbol-cmap",
          "--show-time",
          "--silent",
          "--text",
          "--text-file",
          "--unicodes",
          "--variation"
        ],
        "shortFlags": ["-T", "-b", "-c", "-d", "-o", "-t"],
        "positionals": ["INPUT"]
      },
      "convert": {
        "flags": ["--format", "--output", "--variation"],
        "shortFlags": ["-f", "-o"],
        "positionals": ["INPUT"]
      },
      "coverage": {
        "flags": [
          "--basic-text",
          "--json",
          "--text",
          "--text-file",
          "--unicodes"
        ],
        "shortFlags": ["-b", "-t"],
        "positionals": ["INPUT"]
      },
      "doctor": {
        "flags": [],
        "shortFlags": [],
        "positionals": []
      },
      "init": {
        "flags": [],
        "shortFlags": [],
        "positionals": []
      },
      "inspect": {
        "flags": ["--json"],
        "shortFlags": [],
        "positionals": ["INPUT"]
      },
      "instance": {
        "flags": [
          "--downgrade-cff2",
          "--keep-variable",
          "--output",
          "--variation",
          "--variation-range"
        ],
        "shortFlags": ["-o"],
        "positionals": ["INPUT"]
      },
      "subset": {
        "flags": [
          "--basic-text",
          "--drop-tables",
          "--gids",
          "--glyph-names",
          "--layout-features",
          "--layout-languages",
          "--layout-scripts",
          "--missing-glyphs",
          "--name-ids",
          "--name-languages",
          "--output",
          "--pass-through-tables",
          "--report",
          "--retain-gids",
          "--retain-glyph-names",
          "--retain-legacy-cmap",
          "--retain-symbol-cmap",
          "--text",
          "--text-file",
          "--unicodes"
        ],
        "shortFlags": ["-b", "-o", "-t"],
        "positionals": ["INPUT"]
      }
    },
    "exitCodes": {
      "error": 1,
      "success": 0
    },
    "globalFlags": ["--help", "--version", "-V", "-h"]
  },
  "config": {
    "browser": {
      "assetFields": ["contents", "fileName", "format", "unicodeRanges"],
      "fields": ["assets", "plugins"]
    },
    "node": {
      "fields": [
        "cache",
        "clean",
        "css",
        "cwd",
        "input",
        "outDir",
        "outputs",
        "plugins",
        "preserveOriginal",
        "runtime",
        "subset"
      ],
      "runtimeValues": ["auto", "native", "wasm"]
    },
    "rust": {
      "fields": [
        "cache",
        "clean",
        "css",
        "cwd",
        "delivery",
        "diagnostics",
        "input",
        "otf",
        "outDir",
        "outputs",
        "parallel",
        "plugins",
        "preserveOriginal",
        "subset"
      ],
      "moduleExtensions": ["cjs", "json", "jsonc", "mjs", "mts", "ts"]
    },
    "sharedSubsetFields": [
      "basicText",
      "dropTables",
      "gids",
      "glyphNames",
      "keepLayout",
      "keepNotdef",
      "layoutFeatures",
      "layoutLanguages",
      "layoutScripts",
      "missingGlyphs",
      "nameIds",
      "nameLanguages",
      "passThroughTables",
      "preserveHinting",
      "retainGids",
      "retainGlyphNames",
      "retainLegacyCmap",
      "retainSymbolCmap",
      "text",
      "textFile",
      "trim",
      "unicodes"
    ]
  },
  "diagnosticCodes": [
    "fontmin::config",
    "fontmin::convert_failed",
    "fontmin::invalid_font",
    "fontmin::io",
    "fontmin::missing_glyph",
    "fontmin::napi_bridge_failed",
    "fontmin::plugin_failed",
    "fontmin::unsupported_format"
  ],
  "exports": {
    "node": {
      ".": [
        "FontminDiagnosticError",
        "analyzeCoverage",
        "css",
        "default",
        "defineConfig",
        "definePlugin",
        "deliverySlices",
        "eotToTtf",
        "fontminCompatPreset",
        "generateFontFaceCss",
        "glyph",
        "inspect",
        "instantiateFont",
        "loadConfig",
        "mime",
        "modernWeb",
        "optimize",
        "otf2ttf",
        "otfToTtf",
        "plugins",
        "reduceVariationSpace",
        "subsetTtf",
        "subsetTtfWithReport",
        "svg2ttf",
        "svgFontToTtf",
        "svgs2ttf",
        "svgsToTtf",
        "ttf2eot",
        "ttf2svg",
        "ttf2woff",
        "ttf2woff2",
        "ttfToEot",
        "ttfToSvg",
        "ttfToWoff",
        "ttfToWoff2",
        "ttfToWoff2Async",
        "util",
        "validateWoff2",
        "variationSpace",
        "woff2ToTtf",
        "woffToTtf"
      ],
      "./compat": ["default", "mime", "plugins", "util"],
      "./plugins": [
        "css",
        "definePlugin",
        "deliverySlices",
        "glyph",
        "modernWeb",
        "otf2ttf",
        "svg2ttf",
        "svgs2ttf",
        "ttf2eot",
        "ttf2svg",
        "ttf2woff",
        "ttf2woff2",
        "variationSpace"
      ],
      "./presets": ["fontminCompatPreset", "modernWeb"],
      "./vinyl": ["default"]
    },
    "wasm": {
      ".": [
        "FontminDiagnosticError",
        "analyzeCoverage",
        "css",
        "deliverySlices",
        "eotToTtf",
        "fontminCompatPreset",
        "generateFontFaceCss",
        "glyph",
        "initWasm",
        "inspect",
        "instantiateFont",
        "isWasmInitialized",
        "modernWeb",
        "optimizeBrowser",
        "otf2ttf",
        "otfToTtf",
        "reduceVariationSpace",
        "subsetTtf",
        "subsetTtfWithReport",
        "svg2ttf",
        "svgFontToTtf",
        "svgs2ttf",
        "svgsToTtf",
        "ttf2eot",
        "ttf2svg",
        "ttf2woff",
        "ttf2woff2",
        "ttfToEot",
        "ttfToSvg",
        "ttfToWoff",
        "ttfToWoff2",
        "validateWoff2",
        "variationSpace",
        "woff2ToTtf",
        "woffToTtf"
      ]
    }
  },
  "fileNaming": {
    "default": "{stem}.{extension}",
    "deliverySlice": "{stem}-{slice}.{extension}",
    "iconFontDefaultStem": "iconfont",
    "preserveOriginal": "{input-file-name}"
  },
  "operations": {
    "shared": [
      "analyzeCoverage",
      "eotToTtf",
      "generateFontFaceCss",
      "inspect",
      "instantiateFont",
      "otfToTtf",
      "subsetTtf",
      "subsetTtfWithReport",
      "svgFontToTtf",
      "svgsToTtf",
      "ttfToEot",
      "ttfToSvg",
      "ttfToWoff",
      "ttfToWoff2",
      "validateWoff2",
      "woff2ToTtf",
      "woffToTtf"
    ],
    "nodeOnly": ["ttfToWoff2Async"],
    "nativeBindingNames": {
      "inspect": "inspectFont"
    },
    "wasm": {
      "binary": [
        "analyzeCoverage",
        "eotToTtf",
        "inspect",
        "instantiateFont",
        "otfToTtf",
        "subsetTtf",
        "subsetTtfWithReport",
        "ttfToEot",
        "ttfToSvg",
        "ttfToWoff",
        "ttfToWoff2",
        "validateWoff2",
        "woff2ToTtf",
        "woffToTtf"
      ],
      "text": ["svgFontToTtf"],
      "direct": {
        "generateFontFaceCss": "generate_css",
        "svgsToTtf": "transform_icons"
      }
    }
  },
  "pluginLifecycle": ["buildStart", "transform", "generateBundle", "buildEnd"]
}
